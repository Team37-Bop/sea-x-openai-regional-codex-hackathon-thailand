{
  "name": "bop-trip-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "package:lambda": "npm test && npm audit --omit=dev --audit-level=high && npm run build && node scripts/package-lambda.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@aws-sdk/client-dynamodb": "3.1175.0",
    "@aws-sdk/client-secrets-manager": "3.1175.0",
    "@aws-sdk/lib-dynamodb": "3.1175.0",
    "@line/liff": "2.32.0",
    "ipaddr.js": "2.5.0",
    "maplibre-gl": "6.19.0",
    "openai": "7.62.0",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
