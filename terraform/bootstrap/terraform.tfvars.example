# Copy to a gitignored file or export TF_VAR_expected_account_id.
# Never guess this value; obtain it from the authenticated SSO identity.
expected_account_id = "000000000000"
aws_region           = "us-east-1"

# Replace these with the numeric IDs returned by:
# gh api repos/Team37-Bop/sea-x-openai-regional-codex-hackathon-thailand \
#   --jq '"repository_id=\(.id) owner_id=\(.owner.id)"'
github_owner_id      = "224233918"
github_repository_id = "1466116167"

# Set true only if this AWS account lacks the GitHub OIDC provider.
create_github_oidc_provider = false
